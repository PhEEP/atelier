class="mc">⡀</span><span style="--h:304" class="mc">⠈</span><span style="--h:304" class="mc">⠐</span><span style="--h:304" class="mc">⠠</span><span style="--h:304" class="mc">⢀</span> <span style="--h:304" class="mc">⠂</span><span style="--h:304" class="mc">⠄</span><span style="--h:304" class="mc">⡀</span><span style="--h:304" class="mc">⠈</span><span style="--h:304" class="mc">⠐</span><span style="--h:304" class="mc">⠠</span><span style="--h:304" class="mc">⢀</span><span style="--h:304" class="mc">⠁</span><span style="--h:304" class="mc">⠂</span> <span style="--h:304" class="mc">⡀</span> <span style="--h:304" class="mc">⠐</span><span style="--h:304" class="mc">⠠</span>
